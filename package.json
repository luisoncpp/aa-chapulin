{
  "name": "ace-attorney-chapulin",
  "version": "1.0.0",
  "description": "El Chapulín Colorado: Ace Attorney — Turnabout Red Grasshopper",
  "type": "module",
  "scripts": {
    "start": "npm run build && npx serve .",
    "build": "tsc && node tools/build-deduction.mjs",
    "demo:deduction": "npm run build && node tools/serve-demo.mjs",
    "typecheck": "tsc --noEmit",
    "package": "powershell -ExecutionPolicy Bypass -File ./build.ps1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fallow": "^3.22.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
