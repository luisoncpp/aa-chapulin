{
  "name": "ace-attorney-chapulin",
  "version": "1.0.0",
  "description": "El Chapulín Colorado: Ace Attorney — Turnabout Red Grasshopper",
  "type": "module",
  "scripts": {
    "start": "npm run build && npx serve .",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "package": "powershell -ExecutionPolicy Bypass -File ./package-release.ps1",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  }
}
